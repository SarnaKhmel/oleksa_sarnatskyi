# ─────────────────────────────────────────────────────────────────────────────
#  oleksa-portfolio — what never goes into git.
#  Project rules (branches, versions, releases, tests) live in README.md
#  → "Working on the project"; this file only lists ignored paths.
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies — restored with `npm ci`
/node_modules

# Build output — produced by `npm run build`, deployed by CI, never committed
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Generated CV — rebuilt from src/content by `npm run cv` before dev/build.
# Edit the content, not the PDF.
/public/cv/

# Tests — reports and traces are CI artifacts
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Environment — local only. Copy .env.example → .env.local
.env*
!.env.example

# Secrets and keys must never be committed
*.pem
*.key

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Hosting leftovers
.vercel
