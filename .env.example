# Copy to .env.local for local development. All values are optional and public
# (NEXT_PUBLIC_* ends up in the browser bundle) — never put secrets here.

# Absolute site origin used in metadata, e.g. https://oleksa-sarnatskyi.olsarnat.workers.dev
NEXT_PUBLIC_SITE_URL=

# Only for hosts that serve the site from a sub-path (e.g. /repo). Leave empty otherwise.
NEXT_PUBLIC_BASE_PATH=

# Pin the release date shown on the site (YYYY-MM-DD). Defaults to the build date.
RELEASE_DATE=
